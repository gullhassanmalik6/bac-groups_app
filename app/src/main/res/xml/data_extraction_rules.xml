<?xml version="1.0" encoding="utf-8"?>
<!-- Exclude encrypted session prefs from cloud backup / device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="cryptopos_secure_session.xml" />
        <exclude domain="sharedpref" path="cryptopos_secure_session" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="cryptopos_secure_session.xml" />
        <exclude domain="sharedpref" path="cryptopos_secure_session" />
    </device-transfer>
</data-extraction-rules>
